# web/.env.local — the Next.js website (Vercel). Names + placeholders only.

# InsForge project the website + worker share.
NEXT_PUBLIC_INSFORGE_URL=https://jd3mdkqr.ap-southeast.insforge.app
INSFORGE_URL=https://jd3mdkqr.ap-southeast.insforge.app

# InsForge ADMIN key — bypasses RLS. Server-only (used by createAdminClient in
# server actions to read any run + join auth.users). NEVER expose to the client.
INSFORGE_API_KEY=<REDACTED>

# InsForge ANON key — public, client-safe (RLS-scoped reads/writes for signed-in users).
NEXT_PUBLIC_INSFORGE_ANON_KEY=<REDACTED>

# Demo account the landing "try it" path signs in as (demo users always run $0 mock).
NEXT_PUBLIC_DEMO_EMAIL=<REDACTED>
NEXT_PUBLIC_DEMO_PASSWORD=<REDACTED>

# Developer-mode gate (server-only). Judges pair this via /inside?key=<DEV_MODE_KEY>
# to unlock the inside view (Conversion Read scores, the live agent feed) for any run.
DEV_MODE_KEY=<REDACTED>
