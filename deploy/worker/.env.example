# VM worker env — the Hetzner `filmo-claimer` + the host MCP tool-server.
# On the VM these come from the systemd unit Environment= lines + the secret
# EnvironmentFiles (/root/.insforge-key, /root/.orkey, /root/.el-key) and the
# CLAIMER_MODE / payments drop-ins. Names + placeholders only.

# ── InsForge (the jobs queue + walk-videos bucket) ──────────────────────────
INSFORGE_URL=https://jd3mdkqr.ap-southeast.insforge.app
INSFORGE_API_KEY=<REDACTED>           # /root/.insforge-key — admin key, bypasses RLS
WALK_BUCKET=walk-videos               # do NOT rename (breaks the live deploy)

# ── Brain + media (sourced by start-mcp-toolserver.sh) ──────────────────────
OPENROUTER_API_KEY=<REDACTED>         # /root/.orkey — planner / Nemotron brain
ELEVENLABS_API_KEY=<REDACTED>         # /root/.el-key — optional premium VO (free path default)
ANALYZE_BRAIN=ultra-paid              # Nemotron 550B for the read + plan
WS_PREMIUM_MENU=1                     # cost-plus pricing menu

# ── Pipeline / host paths ───────────────────────────────────────────────────
PIPELINE_DIR=/root/filmo-pipeline
PYTHON_BIN=/root/filmo-venv/bin/python
WORKER_DIR=/root/filmo-worker
INSFORGE_UPLOADER=/root/filmo-worker/insforge_upload.mjs
PRODUCER=hetzner-curated              # producer tag stamped onto delivered runs
MCP_PORT=8770                         # host MCP tool-server port

# ── Hermes-conducted produce path (Phase C) ─────────────────────────────────
CLAIMER_MODE=hermes                   # 'hermes' = conduct in the sandbox; 'direct' = deterministic build_runner
HERMES_SANDBOX=filmo
HERMES_SKILL=filmo-producer
HERMES_PRODUCER=hetzner-hermes
HERMES_TIMEOUT_S=900
NEMOCLAW_SANDBOX=filmo                # the live registered NemoClaw sandbox

# ── In-sandbox capture (default OFF; render always stays on host) ───────────
CAPTURE_BACKEND=native                # 'nemoclaw' = capture inside the sandbox; auto-falls back to native

# ── Stripe TEST payment gate ────────────────────────────────────────────────
STRIPE_SECRET_KEY=<REDACTED>          # /root/.hermes/.env — TEST key only (gate.py refuses live)
PAYMENTS_REQUIRED=true                # kill-switch: false = auto-proceed, no gate
FILMO_PUBLIC_BASE=https://filmostudio.vercel.app
HERMES_PRICE_CAP_CENTS=1000           # $10 cap; the gate always proceeds at the cap
