# Worker env — the Railway service `walk-studio-hosted` (curated claimer + the
# python pipeline). On Railway these are service variables; push them with
# `scripts/railway-push-env.sh` or `railway variables --set`. Names + placeholders
# only, never real values.
#
# CLAIMER_MODE / PRODUCER / PYTHON_BIN are baked into the image (see Dockerfile)
# and normally need no override.

# ── InsForge (the jobs queue + walk-videos bucket) ──────────────────────────
INSFORGE_URL=https://jd3mdkqr.ap-southeast.insforge.app
INSFORGE_API_KEY=<REDACTED>           # admin key, bypasses RLS
WALK_BUCKET=walk-videos               # do NOT rename (breaks the live deploy)

# ── Brain + media ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=<REDACTED>         # the ONLY brain key — every Nemotron call goes via OpenRouter
ELEVENLABS_API_KEY=<REDACTED>         # optional premium VO; edge-tts + whisper is the automatic fallback
ANALYZE_BRAIN=ultra-paid              # Conversion Read brain (Nemotron 550B); the storyboard planner
                                      # brain is per-job and defaults to super-free
WS_PREMIUM_MENU=1                     # cost-plus pricing menu

# ── Pipeline / container paths ──────────────────────────────────────────────
PIPELINE_DIR=/app                     # the image copies the repo to /app
PYTHON_BIN=python3
PRODUCER=railway-curated              # producer tag stamped onto delivered runs
CLAIMER_MODE=curated                  # deterministic build_runner; the ONLY supported production mode

# ── Delivery email (optional; see notifyVideoReady) ─────────────────────────
AGENTMAIL_API_KEY=<REDACTED>          # absent key -> the notify step logs and skips
AGENTMAIL_INBOX=<REDACTED>

# ── Stripe TEST payment gate (opt-in; the live gate is the credit ledger) ───
STRIPE_SECRET_KEY=<REDACTED>          # TEST key only (gate.py refuses live)
PAYMENTS_REQUIRED=true                # kill-switch: false = auto-proceed, no gate
PAYMENT_TIMEOUT_MS=900000
FILMO_PUBLIC_BASE=https://filmo.dev   # Stripe success/cancel return base
FILMO_SITE_BASE=https://filmo.dev     # link used in the "video ready" email
HERMES_PRICE_CAP_CENTS=1000           # $10 cap; the gate always proceeds at the cap
                                      # (legacy variable name, still read by the gate)

# ── RETIRED 2026-07-16 — do NOT set these ───────────────────────────────────
# CLAIMER_MODE=hermes, HERMES_SANDBOX, HERMES_SKILL, HERMES_PRODUCER,
# HERMES_TIMEOUT_S, NEMOCLAW_SANDBOX, CAPTURE_BACKEND, MCP_PORT and the rest of the
# Hermes/NemoClaw conduct env belong to the decommissioned Hetzner VM. Their config
# snapshot lives in deploy/retired/; nothing in the Railway image uses them.
