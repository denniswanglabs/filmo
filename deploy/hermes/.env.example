# ~/.hermes/.env — the Hermes agent / pipeline brain + media keys.
# On the VM these are split across small KEY=VALUE files (/root/.orkey,
# /root/.el-key, /root/.insforge-key, /root/.hermes/.env) that the unit
# EnvironmentFiles + start-mcp-toolserver.sh source. Names + placeholders only.

# OpenRouter — the planner / Nemotron brain (every LLM/reasoning call). PAID so
# there are no free-tier 429s. Lives in /root/.orkey on the VM as OPENROUTER_API_KEY=...
OPENROUTER_API_KEY=<REDACTED>

# NVIDIA — direct NIM/Nemotron inference + `nemoclaw rebuild`. Not stored on the
# live host (the live brain is routed via OpenRouter), but needed for a from-scratch
# NemoClaw sandbox rebuild.
NVIDIA_API_KEY=<REDACTED>

# ElevenLabs — premium VO. PRESENT but the default path is free edge-tts + whisper;
# ElevenLabs is only tried when WS_VO_PROVIDER=elevenlabs (auto-falls back on failure).
ELEVENLABS_API_KEY=<REDACTED>

# Stripe — TEST-mode key for the pre-conduct payment gate (gate.py refuses any
# live/missing key). Lives in /root/.hermes/.env on the VM.
STRIPE_SECRET_KEY=<REDACTED>
