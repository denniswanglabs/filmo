# ── Secrets / credentials (NEVER commit) ────────────────────────────
.env
.env.*
*.env
*.key
*.pem
*secret*
*credentials*
client_secrets.json
.hermes/
# but DO commit the scrubbed deploy snapshot's .env.example templates
# (placeholders only — verified secret-free; see DEPLOY.md)
!deploy/**/.env.example

# ── Dependencies / build artifacts ──────────────────────────────────
node_modules/
# studio/node_modules is a symlink into a sibling project
studio/node_modules
studio/out/
# built editor bundle (regenerate with: cd studio/editor && npm run build)
studio/editor/dist/
# dedicated Playwright capture venv (screenshot capture; ~chromium binary)
.venv-capture/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Backups (the many .bak / .pre-*.bak snapshots) ──────────────────
*.bak
*.pre-*.bak

# ── Generated / large media ─────────────────────────────────────────
*.mp4
*.mov
*.mp3
*.wav
*.m4a
*.aac
# generated run artifacts (keep small ledger.json refs — see below)
# anchored to repo root so it does NOT swallow web/app/runs/ (the editor route)
/runs/*/clips/
/runs/**/*.mp4
/runs/**/*.mp3
/runs/**/*.wav
/runs/**/*.png
/runs/**/*.jpg
# filmo-lab local experiment runs (isolated from production /runs/)
/filmo-lab/runs/*
!/filmo-lab/runs/.gitkeep
# evidence/ holds large render stills + clips — keep only small refs
evidence/**/*.png
evidence/**/*.jpg
evidence/**/*.jpeg
evidence/**/*.mp4
evidence/**/*.mov
# studio public render fixtures (large)
studio/public/*.wav
studio/public/*.mp3
studio/public/*.mp4

# ── Logs / orchestrator session tooling ─────────────────────────────
logs/
*.log
*.output
.watchdog.py

